{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "README.md",
    "STATE.md"
  ],
  "default_agent": "build",
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "http://localhost:22360/sse"],
      "enabled": true
    }
  },
  "tools": {
    "obsidian_*": true,
    "bash": true,
    "write": true,
    "read": true,
    "edit": true
  }
}
