# .env.example
# This file contains example environment variables for the poly-oracle-agent.
# Copy this file to .env and fill in your actual values.

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_MAX_RETRIES=2

# --- Polygon / Web3 ---
POLYGON_RPC_URL=https://rpc.ankr.com/polygon
WALLET_ADDRESS=0xYourWalletAddressHere
WALLET_PRIVATE_KEY=your_private_key_here

# --- Polymarket CLOB ---
CLOB_REST_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
GAMMA_API_URL=https://gamma-api.polymarket.com

# --- Risk parameters ---
KELLY_FRACTION=0.25
MIN_CONFIDENCE=0.75
MAX_SPREAD_PCT=0.015
MAX_EXPOSURE_PCT=0.03
ENABLE_EXPOSURE_VALIDATOR=False
ENABLE_WALLET_BALANCE_CHECK=False
MAX_CATEGORY_EXPOSURE_PCT=0.015
MIN_MATIC_BALANCE_WEI=100000000000000000
MIN_USDC_BALANCE_USDC=10
MIN_EV_THRESHOLD=0.02
MIN_TTR_HOURS=4.0

# --- Bankroll ---
INITIAL_BANKROLL_USDC=1000

# --- Execution Router (WI-16) ---
MAX_ORDER_USDC=50
MAX_SLIPPAGE_TOLERANCE=0.02

# --- Exit Strategy (WI-19) ---
EXIT_POSITION_MAX_AGE_HOURS=48
EXIT_STOP_LOSS_DROP=0.15
EXIT_TAKE_PROFIT_GAIN=0.20
EXIT_SCAN_INTERVAL_SECONDS=60

# --- Portfolio Aggregator (WI-23) ---
ENABLE_PORTFOLIO_AGGREGATOR=False
PORTFOLIO_AGGREGATION_INTERVAL_SEC=30

# --- Alert Engine (WI-25) ---
ALERT_DRAWDOWN_USDC=100
ALERT_STALE_PRICE_PCT=0.50
ALERT_MAX_OPEN_POSITIONS=20
ALERT_LOSS_RATE_PCT=0.60

# --- Telegram Notifier (WI-26) ---
ENABLE_TELEGRAM_NOTIFIER=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_TIMEOUT_SEC=5

# --- Circuit Breaker (WI-27) ---
ENABLE_CIRCUIT_BREAKER=False
CIRCUIT_BREAKER_OVERRIDE_CLOSED=False
EXIT_MIN_BID_TOLERANCE=0.01

# --- Gas ---
MAX_GAS_PRICE_GWEI=500.0
FALLBACK_GAS_PRICE_GWEI=50.0
GAS_CHECK_ENABLED=False
DRY_RUN_GAS_PRICE_WEI=30000000000
GAS_EV_BUFFER_PCT=0.10
MATIC_USDC_PRICE=0.50

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./poly_oracle.db

# --- Grok Sentiment Oracle (WI-12) ---
GROK_API_KEY=your_grok_api_key
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast # Updated from grok-3 for live trading
GROK_MOCKED=False # Set to False for live API
GROK_LIVE_ENABLED=True # Explicitly enable live Grok API calls
GROK_TIMEOUT_SECONDS=2.0
GROK_MAX_RETRIES=2

# --- Operational ---
LOG_LEVEL=INFO
# Phase 14 mandate: MUST remain true; never set false on any Droplet deployment.
DRY_RUN=true

# --- WI-46: WebSocket Reconnect & Health ---
WS_RECONNECT_INITIAL_BACKOFF_SECONDS=1.0
WS_RECONNECT_MAX_BACKOFF_SECONDS=60.0
WS_RECONNECT_JITTER_PCT=0.25
WS_PONG_TIMEOUT_SECONDS=30.0
WS_CONSECUTIVE_FAILURE_DEGRADED_THRESHOLD=5
HEALTH_SERVER_PORT=8080
HEALTH_SERVER_HOST=127.0.0.1
READINESS_GRACE_WINDOW_SECONDS=30.0
ENABLE_HEALTH_SERVER=True

# --- WI-47: Prometheus Metrics ---
METRICS_SERVER_PORT=8081
METRICS_SERVER_HOST=127.0.0.1
ENABLE_METRICS_SERVER=True

# --- WI-49: Secure Remote Dashboard ---
# Path to the SQLite database for the Streamlit dashboard.
# Local default is auto-detected; set for deployed containers.
# DASHBOARD_DB_PATH=/data/poly_oracle.db

# --- WI-32: Concurrent Market Tracking ---
MAX_CONCURRENT_MARKETS=5
MARKET_TRACKING_INTERVAL_SEC=10
# False keeps the conservative single-primary-market runtime.
# Set True to fan out subscriptions up to MAX_CONCURRENT_MARKETS.
ENABLE_MARKET_TRACKING=False
