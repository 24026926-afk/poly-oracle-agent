[Unit]
Description=Poly-Oracle Runtime Review — WI-61 optional advisory LLM reviewer
After=network-online.target poly-oracle-runtime-audit.service
Wants=network-online.target

[Service]
Type=oneshot
User=poly-oracle
WorkingDirectory=/opt/poly-oracle-agent
EnvironmentFile=/opt/poly-oracle-agent/.env
ExecStart=/opt/poly-oracle-agent/.venv/bin/python -c "import asyncio; from src.observability.runtime_audit import run_llm_review; from src.schemas.runtime_audit import RuntimeAuditLLMReviewRequest; import os; asyncio.run(run_llm_review(RuntimeAuditLLMReviewRequest(audit_artifact_path='docs/operations/runtime_audits/latest.json'), api_key=os.environ.get('MOONSHOT_API_KEY'), enabled=os.environ.get('RUNTIME_REVIEW_ENABLED', 'false').lower() == 'true'))"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=poly-oracle-review

# Hardening
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/opt/poly-oracle-agent/docs/operations/runtime_reviews

[Install]
WantedBy=multi-user.target
